---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Shot from '../components/Shot.astro';
import { ambiance, journalTopics } from '../data/site';
---
<Base
  title="Journal | Mecking Exclusive Travel"
  description="Inspirations, conseils et actualités autour de la montagne en hiver et du littoral en été."
>
  <PageHero
    word="Journal"
    title="Inspirations et conseils"
    lead="Des idées de séjours, des conseils pratiques et nos coups de cœur, au fil des saisons."
    photo={ambiance[1]}
  />

  <section class="block">
    <div class="block__head">
      <h2 data-lines>Bientôt dans le journal</h2>
      <p>Les premiers articles sont en préparation. Voici les sujets prévus.</p>
    </div>
    <p class="todo">Aucun article rédigé pour l’instant : sujets proposés, à valider et à rédiger avec le client.</p>
    <ul class="posts" data-rise>
      {journalTopics.map((t) => (
        <li class="post">
          <Shot src={t.photo} sizes="(min-width: 900px) 30vw, 100vw" class="post__shot" />
          <p class="kicker">{t.theme}</p>
          <h3>{t.title}</h3>
          <p class="post__soon">Article à venir</p>
        </li>
      ))}
    </ul>
  </section>

  <script>
    import '../scripts/inner';
  </script>
</Base>
