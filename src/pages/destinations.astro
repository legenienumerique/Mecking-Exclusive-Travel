---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Shot from '../components/Shot.astro';
import { destinationText, destinations, hero } from '../data/site';

const winter = destinations.filter((d) => d.season === 'hiver');
const summer = destinations.filter((d) => d.season === 'ete');
---
<Base
  title="Destinations | Mecking Exclusive Travel"
  description="La montagne l’hiver, le littoral l’été : Alpes, Côte d’Azur, Bretagne, Corse et Provence. D’autres destinations sont possibles selon votre demande."
>
  <PageHero
    word="Destinations"
    title="La montagne l’hiver, le littoral l’été"
    lead="Deux saisons, deux univers. D’autres destinations sont possibles : il suffit de nous en parler."
    photo={hero}
  />

  <section class="block" id="hiver">
    <div class="block__head">
      <h2 data-lines>Hiver, la montagne</h2>
      <p>Les Alpes et leurs grands domaines, pour un séjour entre glisse, calme et bonnes tables.</p>
    </div>
    <p class="todo">Stations et massifs précis à mettre en avant : à fournir par le client.</p>
  </section>

  {winter.map((d) => (
    <article class="service" id={d.name.toLowerCase()}>
      <Shot src={d.photo} sizes="(min-width: 900px) 55vw, 100vw" class="service__shot" data-shape />
      <div class="service__text">
        <p class="kicker">Hiver</p>
        <h3 class="service__title" data-lines>{d.name}</h3>
        <p>{destinationText[d.name]}</p>
        <a class="btn" href={`/contact?destination=${encodeURIComponent(d.name)}`}>Parler de ce séjour</a>
      </div>
    </article>
  ))}

  <section class="block" id="ete">
    <div class="block__head">
      <h2 data-lines>Été, le littoral</h2>
      <p>Côte d’Azur, Bretagne, Corse et Provence : quatre façons de vivre l’été au bord de l’eau.</p>
    </div>
  </section>

  {summer.map((d, i) => (
    <article class:list={['service', { 'service--flip': i % 2 === 0 }]}>
      <Shot src={d.photo} sizes="(min-width: 900px) 55vw, 100vw" class="service__shot" data-shape />
      <div class="service__text">
        <p class="kicker">Été</p>
        <h3 class="service__title" data-lines>{d.name}</h3>
        <p>{destinationText[d.name]}</p>
        <a class="btn" href={`/contact?destination=${encodeURIComponent(d.name)}`}>Parler de ce séjour</a>
      </div>
    </article>
  ))}

  <section class="end end--plain">
    <div class="end__text">
      <h2 class="end__title" data-lines>Une autre destination en tête ?</h2>
      <a class="btn" href="/contact">Nous en parler</a>
    </div>
  </section>

  <script>
    import '../scripts/inner';
  </script>
</Base>
