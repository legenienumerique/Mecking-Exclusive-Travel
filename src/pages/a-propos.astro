---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Shot from '../components/Shot.astro';
import { ambiance, brand, values, link } from '../data/site';
---
<Base
  title="À propos | Mecking Exclusive Travel"
  description="Une conciergerie privée basée à Lyon, au service d’une clientèle exigeante partout en France : discrétion, sur-mesure et un interlocuteur unique."
>
  <PageHero
    word="Mecking"
    title="Une conciergerie privée, une seule personne à vos côtés"
    lead={`Basée à ${brand.city}, elle accompagne des voyageurs de toute la France, à la montagne l’hiver et sur le littoral l’été.`}
    photo={ambiance[0]}
  />

  <section class="about">
    <div class="about__portrait todo todo--box" data-rise>
      <span>Portrait du concierge : à fournir par le client.</span>
    </div>
    <div class="about__text">
      <h2 data-lines>Le parcours</h2>
      <p class="todo">Parcours, expérience et motivations du concierge : à fournir par le client.</p>
    </div>
  </section>

  <section class="block">
    <div class="block__head">
      <h2 data-lines>Notre approche</h2>
      <p>Ce qui compte pour celles et ceux qui nous confient leurs séjours.</p>
    </div>
    <ul class="values" data-rise>
      {values.map((v) => (
        <li>
          <h3>{v.title}</h3>
          <p>{v.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="band">
    <Shot src={ambiance[3]} class="band__shot" data-shape />
  </section>

  <section class="end end--plain">
    <div class="end__text">
      <h2 class="end__title" data-lines>Faisons connaissance.</h2>
      <a class="btn" href={link("/contact")}>Prendre contact</a>
    </div>
  </section>

  <script>
    import '../scripts/inner';
  </script>
</Base>
